# Docker Environment Variables Example
# Copy this file to .env and fill in your values

# ========================================
# BACKEND ENVIRONMENT VARIABLES
# ========================================
NODE_ENV=production
PORT=5001

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# CORS
CORS_ORIGIN=http://localhost:3000

# JWT Secrets (generate strong random strings)
JWT_SECRET=your-jwt-secret-here
ADMIN_JWT_SECRET=your-admin-jwt-secret-here

# ========================================
# FRONTEND ENVIRONMENT VARIABLES
# ========================================
VITE_API_URL=http://localhost:5001/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ========================================
# NOTES
# ========================================
# 1. Generate strong secrets: openssl rand -base64 32
# 2. Get Supabase keys from: https://app.supabase.com/project/_/settings/api
# 3. For production, use environment-specific values
# 4. Never commit .env file to git
